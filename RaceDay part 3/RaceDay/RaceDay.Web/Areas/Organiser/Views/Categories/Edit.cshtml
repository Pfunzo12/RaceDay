@model CategoryFormViewModel
@{ ViewData["Title"] = "Edit category"; }
<div class="page-head"><h1>Edit category</h1></div>
<div class="rd-card card-pad" style="max-width:640px">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
        <input type="hidden" asp-for="EventId" />
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Name *</label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-6">
                <label asp-for="DistanceKm" class="form-label">Distance (km) *</label>
                <input asp-for="DistanceKm" class="form-control" type="number" step="0.01" min="0.1" required />
                <span asp-validation-for="DistanceKm" class="text-danger small"></span>
            </div>
            <div class="col-6">
                <label asp-for="Price" class="form-label">Price (R) *</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" required />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="MaxParticipants" class="form-label">Max participants *</label>
            <input asp-for="MaxParticipants" class="form-control" type="number" min="1" required />
            <span asp-validation-for="MaxParticipants" class="text-danger small"></span>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-6"><label asp-for="MinAge" class="form-label"></label>
                <input asp-for="MinAge" class="form-control" type="number" min="0" max="120" />
                <span asp-validation-for="MinAge" class="text-danger small"></span></div>
            <div class="col-6"><label asp-for="MaxAge" class="form-label"></label>
                <input asp-for="MaxAge" class="form-control" type="number" min="0" max="120" />
                <span asp-validation-for="MaxAge" class="text-danger small"></span></div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-eventId="@Model.EventId">Cancel</a>
        </div>
    </form>
</div>
