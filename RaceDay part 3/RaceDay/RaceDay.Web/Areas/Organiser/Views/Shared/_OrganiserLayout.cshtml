@{
    var name = Context.Session.CurrentName();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · RaceDay Organiser</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="org-shell">
    <aside class="org-sidebar">
        <a class="brand" asp-area="Organiser" asp-controller="Dashboard" asp-action="Index">Race<span>Day</span></a>
        <span class="org-badge">Organiser</span>
        <ul class="nav flex-column">
            <li><a class="nav-link @Active("Dashboard")" asp-area="Organiser" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
            <li><a class="nav-link @Active("Events")" asp-area="Organiser" asp-controller="Events" asp-action="Index">Events</a></li>
            <li><a class="nav-link @Active("Categories")" asp-area="Organiser" asp-controller="Categories" asp-action="Index">Categories</a></li>
            <li><a class="nav-link @Active("Enrolments")" asp-area="Organiser" asp-controller="Enrolments" asp-action="Index">Enrolments</a></li>
            <li><a class="nav-link @Active("Results")" asp-area="Organiser" asp-controller="Results" asp-action="Index">Results</a></li>
        </ul>
        <div class="org-user">
            <div class="mb-2">Signed in as<br /><strong class="text-white">@name</strong></div>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-light-outline btn-sm w-100">Log out</button>
            </form>
        </div>
    </aside>
    <main class="org-main">
        <partial name="_Alerts" />
        @RenderBody()
    </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
