@model ProfileViewModel
@{
    ViewData["Title"] = "My profile";
    var initial = string.IsNullOrWhiteSpace(Model.FullName) ? "?" : Model.FullName.Trim()[0].ToString().ToUpper();
}
<div class="page-head">
    <div>
        <h1>My profile</h1>
        <p class="page-sub">Keep your details up to date for race day.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="rd-card card-pad text-center">
            @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
            {
                <img class="avatar mb-3" alt="Profile picture" src="@Url.Action("Image", "Media", new { area = "", path = Model.ProfilePicturePath })" />
            }
            else
            {
                <div class="avatar mb-3">@initial</div>
            }
            <h3 class="mb-0">@Model.FullName</h3>
            <p class="text-secondary">@Model.Email</p>
            <form asp-action="Picture" method="post" enctype="multipart/form-data" class="text-start">
                <label class="form-label" for="picture">Profile picture</label>
                <input class="form-control mb-2" type="file" id="picture" name="picture" accept=".jpg,.jpeg,.png,.webp,image/*" required />
                <div class="form-text mb-3">JPG, PNG or WEBP, up to 2 MB.</div>
                <button type="submit" class="btn btn-navy w-100">Upload picture</button>
            </form>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="rd-card card-pad">
            <h3>Personal information</h3>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <form asp-action="Index" method="post" novalidate>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input class="form-control" value="@Model.Email" disabled />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DateOfBirth" class="form-label"></label>
                        <input asp-for="DateOfBirth" class="form-control" />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ClubName" class="form-label"></label>
                        <input asp-for="ClubName" class="form-control" />
                        <span asp-validation-for="ClubName" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="EmergencyContact" class="form-label"></label>
                        <input asp-for="EmergencyContact" class="form-control" placeholder="Name and phone number" />
                        <span asp-validation-for="EmergencyContact" class="text-danger small"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-4">Save changes</button>
            </form>
        </div>
    </div>
</div>
