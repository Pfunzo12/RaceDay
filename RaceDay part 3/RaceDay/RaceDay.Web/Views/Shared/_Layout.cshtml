@{
    var authed = Context.Session.IsAuthenticated();
    var role = Context.Session.CurrentRole();
    var name = Context.Session.CurrentName();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@1,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-rd">
    <div class="container">
        <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">Race<span>Day</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                @if (authed && role == "participant")
                {
                    <li class="nav-item"><a class="nav-link @Active("Events")" asp-area="Participant" asp-controller="Events" asp-action="Index">Find Events</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Enrolments")" asp-area="Participant" asp-controller="Enrolments" asp-action="Index">My Enrolments</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Results")" asp-area="Participant" asp-controller="Results" asp-action="Index">My Results</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Profile")" asp-area="Participant" asp-controller="Profile" asp-action="Index">Profile</a></li>
                }
                else if (authed && role == "organiser")
                {
                    <li class="nav-item"><a class="nav-link" asp-area="Organiser" asp-controller="Dashboard" asp-action="Index">Organiser Dashboard</a></li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link @Active("Home")" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                }
            </ul>
            <div class="d-flex align-items-center gap-2">
                @if (authed)
                {
                    <span class="user-chip">@name · @UiHelpers.Capitalise(role)</span>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-light-outline btn-sm">Log out</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-light-outline btn-sm" asp-area="" asp-controller="Account" asp-action="Login">Log in</a>
                    <a class="btn btn-primary btn-sm" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                }
            </div>
        </div>
    </div>
</nav>

<main class="container py-4">
    <partial name="_Alerts" />
    @RenderBody()
</main>

<footer class="rd-footer">&copy; @DateTime.Now.Year RaceDay · Run. Race. Repeat.</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
